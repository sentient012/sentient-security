  "scripts": {
    "build": "node tools/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.experimental.json && node --test test/*.test.mjs",
    "test:packed": "node tools/test-packed.mjs",
    "verify:pack": "node tools/verify-pack.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@noble/post-quantum": "0.6.1",
