{
  "name": "@sentient012/security",
  "version": "0.4.1",
  "description": "The cryptographic core of the Sentient app and Sentient Business Terminal: post-quantum (X25519 + ML-KEM-768) key agreement and ratcheting, signed device lists, identity verification, group sender keys, Business Terminal rosters, authenticated post-quantum calls, key transparency and two-key recovery, plus the formats used to interoperate with earlier Sentient releases.",
  "license": "Apache-2.0",
  "author": "Sentient",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentient012/sentient-security.git"
  },
  "homepage": "https://github.com/sentient012/sentient-security#readme",
  "bugs": {
    "url": "https://github.com/sentient012/sentient-security/security/advisories/new"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "SECURITY.md",
    "THREAT_MODEL.md",
    "PROTOCOLS.md",
    "CHANGELOG.md",
    "RESEARCHERS.md",
    "docs/session-protocols.md",
    "ROADMAP.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./encoding": {
      "types": "./dist/encoding/index.d.ts",
      "default": "./dist/encoding/index.js"
    },
    "./kem": {
